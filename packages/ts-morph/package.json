{
  "name": "ts-morph",
  "version": "28.0.0",
  "description": "TypeScript compiler wrapper for static analysis and code manipulation.",
  "main": "dist/ts-morph.js",
  "types": "dist-declarations/main.d.ts",
  "scripts": {
    "build": "rimraf dist-cg dist dist-declarations && tsc -p tsconfig.build.json && rollup -c",
    "build:declarations": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "type-check": "tsc -p tsconfig.json --rootDir ../.. --noEmit",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js --require ../scripts/nativeCompilerCleanup.cjs",
    "test:ci": "npm test",
    "code-generate": "node --import tsx scripts/generation/main.ts",
    "code-verification": "node --import tsx scripts/verification/main.ts ensure-structures-match-classes ensure-overload-structures-match ensure-array-inputs-readonly ensure-classes-implement-structure-methods ensure-mixin-not-applied-multiple-times validate-public-api-class-member-names validate-compiler-node-to-wrapped-type validate-code-fences",
    "type-check-docs": "node --import tsx scripts/typeCheckDocumentation.ts"
  },
  "repository": "git+https://github.com/dsherret/ts-morph.git",
  "keywords": [
    "typescript",
    "ast",
    "static analysis",
    "code generation",
    "code refactor"
  ],
  "author": "David Sherret",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dsherret/ts-morph/issues"
  },
  "homepage": "https://github.com/dsherret/ts-morph#readme",
  "dependencies": {
    "@ts-morph/common": "~0.29.0",
    "code-block-writer": "^13.0.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.1",
    "@types/diff": "^7.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.1",
    "chai": "^5.2.0",
    "conditional-type-checks": "^1.0.6",
    "cross-env": "^7.0.3",
    "diff": "^7.0.0",
    "mocha": "11.1.0",
    "rimraf": "^6.0.1",
    "rollup": "=4.40.0",
    "typescript": "7.1.0-beta"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "dist-declarations",
    "readme.md",
    "LICENSE"
  ]
}
