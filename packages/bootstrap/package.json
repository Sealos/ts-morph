{
  "name": "@ts-morph/bootstrap",
  "version": "0.29.0",
  "description": "API for getting quickly set up with the TypeScript Compiler API.",
  "keywords": [
    "typescript",
    "compiler",
    "bootstrap"
  ],
  "main": "dist/ts-morph-bootstrap.js",
  "types": "dist-declarations/index.d.ts",
  "author": "David Sherret",
  "license": "MIT",
  "repository": "git+https://github.com/dsherret/ts-morph.git",
  "scripts": {
    "build": "rimraf dist-cg dist dist-declarations && tsc -p tsconfig.build.json && rollup -c",
    "build:declarations": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "type-check": "tsc -p tsconfig.json --rootDir ../.. --noEmit",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js --require ../scripts/nativeCompilerCleanup.cjs",
    "test:ci": "npm test"
  },
  "dependencies": {
    "@ts-morph/common": "~0.29.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.1",
    "chai": "^5.2.0",
    "cross-env": "^7.0.3",
    "mocha": "^11.1.0",
    "rimraf": "^6.0.1",
    "rollup": "=4.40.0",
    "tslib": "^2.8.1",
    "typescript": "7.1.0-beta"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "dist-declarations",
    "readme.md",
    "LICENSE"
  ]
}
